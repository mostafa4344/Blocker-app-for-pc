# Copy to .env (local) or set via `supabase secrets set`. NEVER commit real values.

# Supabase project (service role is server-only; never ship to clients)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key                 # safe for web client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key # Edge Functions only

# Secret used to sign/verify per-device JWTs (>= 32 random bytes, base64/hex)
DEVICE_JWT_SECRET=generate-a-long-random-secret

# Firebase Cloud Messaging (wake signal to devices). Server key is secret.
FCM_SERVER_KEY=your-fcm-server-key

# Token lifetimes
ENROLLMENT_TOKEN_TTL_MINUTES=15
DEVICE_JWT_TTL_DAYS=30
