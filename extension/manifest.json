{
  "manifest_version": 3,
  "name": "Content Guard",
  "version": "1.0.0",
  "description": "Companion for the Content Guard blocker: block pages, keyword & path blocking, and hide Shorts, Reels and feeds.",
  "icons": {
    "128": "icons/icon.png",
    "48": "icons/icon48.png",
    "16": "icons/icon16.png"
  },
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "tabs",
    "alarms",
    "idle"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "rules.js",
      "background.js"
    ]
  },
  "incognito": "spanning",
  "action": {
    "default_title": "Content Guard",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.facebook.com/*",
        "*://*.instagram.com/*",
        "*://*.x.com/*",
        "*://*.twitter.com/*",
        "*://*.linkedin.com/*"
      ],
      "js": [
        "distraction.js"
      ],
      "css": [
        "distraction.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@contentguard.app",
      "strict_min_version": "121.0"
    }
  }
}