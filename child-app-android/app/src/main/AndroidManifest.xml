<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Persistent foreground service that shows the required notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Lets the enforcement service bring up the block screen from the background
         (grants background-activity-start). The user grants it via Settings in the
         permissions flow; it is disclosed as part of how blocking works. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Usage stats for screen-time reports (special access; justify in Play listing). -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" xmlns:tools="http://schemas.android.com/tools" />

    <!-- Location is OPTIONAL and only used when the parent enables family location sharing. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- NOTE: We deliberately do NOT request SMS/CALL_LOG/RECORD_AUDIO/CAMERA for monitoring.
         Capturing message/call content or ambient audio would violate Google Play policy. -->

    <application
        android:name=".FamilyGuardApp"
        android:icon="@drawable/ic_shield"
        android:label="@string/app_name"
        android:allowBackup="false"
        android:theme="@style/Theme.FamilyGuard">

        <!-- Launcher icon is ALWAYS visible. There is no alias to hide it. (Compliance C2) -->
        <activity
            android:name=".ui.EnrollmentActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.DisclosureActivity" android:exported="false" />
        <activity android:name=".ui.TransparencyActivity" android:exported="false" />
        <activity android:name=".ui.PermissionsActivity" android:exported="false" />

        <!-- Friendly full-screen block shown over a blocked/limited app. -->
        <activity
            android:name=".ui.BlockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.FamilyGuard" />

        <!-- Persistent-notification service (Compliance C1). specialUse = parental control. -->
        <service
            android:name=".service.GuardForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="parental_control_persistent_status" />
        </service>

        <!-- Device Admin receiver (removal resistance). -->
        <receiver
            android:name=".admin.GuardDeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.DEVICE_ADMIN_DISABLE_REQUESTED" />
            </intent-filter>
        </receiver>

        <!-- Restart the persistent service after reboot. -->
        <receiver android:name=".service.BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- FCM wake receiver (silent "sync now" nudges).
             Enable once Firebase is configured (google-services.json + plugin +
             firebase-messaging dependency) and the FcmService class is uncommented. -->
        <!--
        <service
            android:name=".work.FcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        -->


    </application>
</manifest>
