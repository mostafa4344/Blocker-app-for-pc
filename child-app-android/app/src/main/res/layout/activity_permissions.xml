<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/perm_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <!-- Usage access -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/perm_usage" android:textSize="16sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/usageStatus" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="20sp" android:text="✗" />
            <Button android:id="@+id/grantUsage" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginStart="12dp"
                android:text="@string/perm_grant" />
        </LinearLayout>

        <!-- Overlay -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="@string/perm_overlay" android:textSize="16sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/overlayStatus" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="20sp" android:text="✗" />
            <Button android:id="@+id/grantOverlay" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginStart="12dp"
                android:text="@string/perm_grant" />
        </LinearLayout>

        <!-- Notifications -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="@string/perm_notif" android:textSize="16sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/notifStatus" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="20sp" android:text="✗" />
            <Button android:id="@+id/grantNotif" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginStart="12dp"
                android:text="@string/perm_grant" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
